# =============================================================================
# Frontend environment variables — copy to `.env` and adjust for your stack.
#
#   cp frontend/.env.example frontend/.env
#
# Vite only exposes variables prefixed with `VITE_` to the browser bundle.
# Anything else is dev-server-only and will not reach the client.
# =============================================================================

# REST API base URL — every fetch goes through here.
VITE_API_URL=http://localhost:3000/api/v1

# Socket.IO server URL — the client will append /socket.io itself.
VITE_SOCKET_URL=http://localhost:3000
