# =============================================================================
# Backend environment variables — copy to `.env` and fill in local values.
#
#   cp backend/.env.example backend/.env
#
# Never commit `.env` itself; only this example file is checked in. Joi
# (see src/config/validation.schema.ts) will refuse to boot the app if any
# required variable is missing or malformed.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# --- MongoDB -----------------------------------------------------------------
# For docker-compose, replace `localhost` with `mongo`.
MONGO_URI=mongodb://localhost:27017/tasksync

# --- Redis -------------------------------------------------------------------
# For docker-compose, replace `localhost` with `redis`.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---------------------------------------------------------------------
# Generate strong secrets in production:  openssl rand -hex 64
# Joi enforces a 32-character minimum to deter accidental weak values.
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-string-of-32-plus-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- CORS --------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
